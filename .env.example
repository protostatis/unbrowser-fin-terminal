# Server-side provider configuration for local development.
# Export these variables before running `npm run dev`; the Node broker reads
# process.env directly rather than Vite's client-side env loader.
OPENROUTER_API_KEY=
UNBROWSER_MCP_URL=https://unchainedsky.com/unbrowser-mcp

# Production should use a dedicated private MCP endpoint instead:
# UNBROWSER_MCP_URL=http://unbrowser-mcp:8767/mcp
