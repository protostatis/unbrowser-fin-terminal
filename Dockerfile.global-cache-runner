FROM node:22.23.2-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/patch-pi-brace-expansion.mjs ./scripts/
RUN npm ci

COPY tsconfig.server.json ./
COPY server ./server
COPY shared ./shared
RUN npx tsc -p tsconfig.server.json

FROM node:22.23.2-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS production-dependencies

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/patch-pi-brace-expansion.mjs ./scripts/
RUN npm ci --omit=dev --omit=optional && npm cache clean --force

FROM node:22.23.2-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS runtime

ARG VCS_REF=unknown
ENV NODE_ENV=production \
    MARKET_DATA_DIR=/data \
    GLOBAL_CACHE_DIR=/data/global-cache \
    HOME=/tmp/home \
    XDG_CACHE_HOME=/tmp/cache

LABEL org.opencontainers.image.source="https://github.com/protostatis/unbrowser-fin-terminal" \
      org.opencontainers.image.revision="$VCS_REF"

WORKDIR /app
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist-server ./dist-server
COPY package.json ./package.json

RUN node --input-type=module -e "await import('./dist-server/server/global-cache-runner.js')"
RUN mkdir -p /data/global-cache && chown -R node:node /data

USER node
CMD ["node", "dist-server/server/global-cache-runner-main.js"]
