{
  "name": "market-terminal-webui",
  "version": "0.1.0",
  "private": true,
  "description": "Keyboard-first Pi market terminal with a browser projection of its canonical extension.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-pi-brace-expansion.mjs",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "node dist-server/server/index.js",
    "start:browser-terminal": "node dist-server/server/browser-terminal-main.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:browser-terminal": "tsc -p tsconfig.browser-server.json && PUBLIC_BASE_PATH=\"${PUBLIC_BASE_PATH:-/fin-terminal-browser/}\" VITE_TERMINAL_BUILD_MODE=browser vite build",
    "build:browser-session": "vite build --config vite.browser-session.config.ts",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:nemo": "tsx scripts/test-nemo.ts",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright test --config=playwright.browser-terminal.config.ts",
    "test:e2e:browser:dev": "playwright test --config=playwright.browser-terminal.dev.config.ts",
    "capture:trace": "tsx scripts/capture-pi-trace.ts",
    "replay:trace": "tsx scripts/replay-pi-trace.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "brace-expansion": "5.0.8",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.7.0",
    "typebox": "1.3.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
